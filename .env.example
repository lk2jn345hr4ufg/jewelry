APP_NAME="Gleamion.com"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# In production: APP_URL=https://gleamion.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jewelry_directory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Set to lock the whole site behind a shared password (leave empty to keep it open)
SITE_PASSWORD=

# ---------- Vouchers API ----------
# Comma-separated tokens for the X-API-Token header (empty = API closed)
VOUCHERS_API_TOKENS=
# Create a store when an offer arrives for an unknown shop_url
VOUCHERS_AUTOCREATE_STORES=true
# Should auto-created stores be visible on the site right away?
VOUCHERS_AUTOCREATE_STORE_ACTIVE=false
# Category assigned to auto-created stores when the feed gives no known one
VOUCHERS_DEFAULT_CATEGORY_ID=
# Publish imported coupons immediately
VOUCHERS_COUPON_ACTIVE=true
VOUCHERS_MAX_BATCH=500
VOUCHERS_MAX_PER_PAGE=500
